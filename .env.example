# Local development. Codes are written to the server terminal.
APP_ENV=development
EMAIL_MODE=log
APP_ORIGIN=http://127.0.0.1:8080
LISTEN_ADDR=127.0.0.1:8080
DATABASE_PATH=data/karma.db
# Set all of these for production; use an HTTPS reverse proxy.
# APP_ENV=production
# EMAIL_MODE=resend
# APP_ORIGIN=https://practice.example.com
# LISTEN_ADDR=0.0.0.0:8080
# SESSION_SECRET=replace-with-at-least-32-random-characters
# RESEND_API_KEY=your-resend-key
# EMAIL_FROM=Karma <login@your-verified-domain.example>
