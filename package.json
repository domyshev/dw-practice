{
  "name": "karma-practice",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev:mock": "node scripts/dev-mock.mjs",
    "mock:api": "go run ./backend --mock",
    "mock:web": "vite --mode mock --host 127.0.0.1",
    "mock:reset": "node scripts/mock-reset.mjs",
    "mock:smoke": "node scripts/mock-smoke.mjs",
    "ios:prepare": "node scripts/ios-prepare.mjs",
    "ios:mock": "node scripts/ios-prepare.mjs --mock",
    "ios:open": "cap open ios",
    "ios:build": "node scripts/ios-build.mjs",
    "ios:run": "node scripts/ios-run.mjs"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "@reduxjs/toolkit": "^2.9.0",
    "@tanstack/react-virtual": "^3.14.24",
    "exceljs": "^4.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
